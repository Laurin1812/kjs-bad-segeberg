# Root-Schutzregeln fuer einen echten Apache-Webserver (Security-/
# Datenschutz-Hardening, Pass 2, 11.09.2026).
#
# WICHTIG: Diese Datei wirkt NUR auf Apache mit aktiviertem AllowOverride
# fuer diesen Ordner. Auf Netlify hat sie GAR KEINE Wirkung (Netlify wertet
# .htaccess nicht aus) - der Schutz fuer die Netlify-Umgebung laeuft
# ausschliesslich ueber die Datei "_redirects" im selben Ordner. Beide
# Dateien decken bewusst denselben Zweck fuer die jeweils andere Umgebung ab
# und muessen bei neuen sensiblen Pfaden BEIDE gepflegt werden.
#
# Diese Datei ergaenzt die bereits bestehenden Ordner-eigenen .htaccess-
# Dateien (config/, database/, vendor/, api/lib/, uploads/) um Regeln, die
# NICHT an einen einzelnen Ordner gebunden sind, sondern ueberall im
# Webroot greifen sollen (z.B. eine versehentlich falsch abgelegte .sql-
# oder .env-Datei, ganz gleich in welchem Unterordner).
#
# Carsten (siehe Abschlussbericht fuer die vollstaendige Liste): bitte vor
# dem Go-Live pruefen, ob der echte Hosting-Server (kjs.mysolution-
# webservice.de) tatsaechlich Apache mit mod_rewrite/mod_authz_core ist und
# ob AllowOverride fuer den Webroot aktiv ist - sonst hat diese Datei keine
# Wirkung und der Schutz muss aequivalent in der zentralen vHost-/Server-
# Konfiguration (oder, bei nginx, per "location"-Bloecken) nachgebaut
# werden. Eine vorbereitete nginx-Variante steht als Kommentar am Ende
# dieser Datei.

# ── .git/ (Versionskontrolle, kann komplette Historie inkl. evtl. frueher
#    versehentlich committeter Secrets offenlegen) - rekursiv blockiert,
#    unabhaengig davon, in welchem Ordner ein .git/ jemals landen sollte ──
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} (^|/)\.git(/|$) [NC]
    RewriteRule .* - [F,L]
</IfModule>
# Fallback ohne mod_rewrite: zumindest das .git-Verzeichnis im Webroot direkt sperren.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        <DirectoryMatch "(^|/)\.git(/|$)">
            Require all denied
        </DirectoryMatch>
    </IfModule>
    <IfModule !mod_authz_core.c>
        <DirectoryMatch "(^|/)\.git(/|$)">
            Order deny,allow
            Deny from all
        </DirectoryMatch>
    </IfModule>
</IfModule>

# ── Sonstige "unsichtbare" Dateien (.env, .htpasswd, .DS_Store, ...) ──
# .htaccess selbst ist bei Apache >= 2.4 standardmaessig bereits geschuetzt
# (AccessFileName-Konvention); diese Regel sperrt zusaetzlich alle anderen
# punktbeginnenden Dateien, insbesondere .env, das laut .gitignore zwar nie
# committet werden soll, aber direkt auf dem Server abgelegt sein koennte.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Datenbank-Dumps, Logs, lokale Konfigurationsdateien mit echten
#    Zugangsdaten, Backup-/Editor-Restdateien, interne Planungsnotizen ──
# *.md ist bewusst mit dabei: auf dieser Seite gibt es aktuell keine
# einzige Seite, die eine .md-Datei per HTTP direkt anzeigt (Inhalte laufen
# ausschliesslich ueber die content/*.json-Dateien) - alle vorhandenen
# .md-Dateien im Repo-Wurzelverzeichnis sind interne Planungsnotizen bzw.
# ein verwaister Test-Datensatz (content/seiten-kjs/verbraucher.md), keine
# fuer Besucher gedachten Inhalte.
<FilesMatch "\.(sql|log|local\.php|bak|backup|old|orig|swp|md)$|~$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Einmalige Entwickler-/Migrationsskripte im Repo-Wurzelverzeichnis
#    (fix_nav.py, fix_flyout_nav.py) - fuer den PHP-Host ohnehin nicht
#    ausfuehrbar, sollen aber auch nicht als Quelltext abrufbar sein ──
<FilesMatch "\.py$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Laravel-Bruecke fuer /api/content/* und /api/admin/* (Phase 7,
#    "Laravel-Konflikte pruefen") ──────────────────────────────────────────
# Diese Website hat zwei PHP-Ebenen im selben Webroot:
#   1) die bestehenden, eigenstaendigen Endpunkte unter api/hundeboerse/*.php,
#      api/waffenboerse/*.php, api/kontakt/*.php, api/contact.php - das sind
#      ECHTE Dateien im Webroot. Apache liefert/fuehrt sie ganz normal aus,
#      OHNE dass die Regel unten eingreift (die Bedingung
#      "RewriteCond %{REQUEST_FILENAME} !-f" schliesst sie bewusst aus) -
#      live in dieser Analyse geprueft: mit UND ohne diese Regel bleibt
#      z.B. "/api/hundeboerse/anzeigen.php" unveraendert erreichbar.
#   2) die Laravel-Anwendung unter laravel/ (Content-/Admin-Schreib- und
#      Lese-Weg, siehe laravel/routes/api.php) - ihr Front-Controller liegt
#      unter laravel/public/index.php und ist unter der oeffentlichen URL
#      "/api/content/..." bzw. "/api/admin/..." selbst KEINE echte Datei im
#      Webroot. OHNE die Regel unten liefert Apache fuer z.B.
#      "/api/content/navigation.json" nur ein eigenes "404 Not Found" aus -
#      Laravel wird nie erreicht (live in dieser Analyse mit einem echten
#      Apache+mod_rewrite nachgestellt und bestaetigt, siehe Abschlussbericht
#      Phase 7, Punkt "Routing-/Rewrite-Konflikte").
#
# Die Regel greift NUR, wenn (a) der Pfad mit /api/content/ oder /api/admin/
# beginnt UND (b) dort weder eine echte Datei noch ein echtes Verzeichnis
# existiert - genau das trifft auf jede Laravel-Route zu, waehrend
# api/hundeboerse/*.php & co. immer echte Dateien sind und daher unveraendert
# direkt ausgeliefert werden. Es ist ein interner Rewrite (kein Redirect):
# REQUEST_URI bleibt fuer PHP/Laravel unveraendert sichtbar, Laravels eigenes
# Routing (routes/api.php) funktioniert dadurch genauso wie im lokalen
# "php artisan serve"-Test.
#
# IN DIESER SANDBOX VERIFIZIERT (kein echtes mod_php/PHP-FPM verfuegbar,
# siehe Abschlussbericht): ueber einen echten Apache mit dieser Regel, per
# Reverse-Proxy an eine laufende "php artisan serve"-Instanz statt direkt an
# laravel/public/index.php (identisches Ergebnis aus Laravels Sicht, da
# beide Wege dieselbe REQUEST_URI an Laravel weiterreichen) - bestaetigt:
# "/api/content/navigation.json" liefert echtes Laravel-JSON, ein
# ungueltiges "/api/admin/..."-PATCH liefert Laravels eigenes 401-JSON
# (Middleware laeuft also vollstaendig), "/admin/index.html" und
# "/api/hundeboerse/anzeigen.php" bleiben unveraendert direkt erreichbar,
# und eine beliebige andere nicht existierende URL wird NICHT an Laravel
# durchgereicht (kein versehentliches "Verschlucken" der gesamten Seite).
#
# WICHTIG - Carsten: nach dem ersten Deploy auf den echten Server bitte
# einmal live gegenpruefen (z.B. "/api/content/navigation.json" im Browser
# oder per curl aufrufen und echtes JSON statt 404 erwarten) - der
# tatsaechliche mod_php/PHP-FPM-Betrieb auf dem echten Server konnte in
# dieser Sandbox mangels Internetzugriffs fuer diese PHP-Apache-Pakete nicht
# 1:1 nachgestellt werden, nur die Rewrite-Logik selbst (s.o.).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/api/(content|admin)/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ laravel/public/index.php [L]
</IfModule>

# ── Verzeichnislisten global aus - falls fuer einen Ordner kein eigener
#    "index.html"/"index.php" existiert, soll kein Datei-Listing erscheinen ──
Options -Indexes

# ──────────────────────────────────────────────────────────────────────
# NUR ALS VORLAGE, falls der echte Host statt Apache doch nginx ist (oder
# Apache als reiner nginx-Reverse-Proxy-Client ohne AllowOverride laeuft):
# diese Datei haette dann GAR KEINE Wirkung. Carsten muesste in diesem Fall
# sinngemaess folgende "location"-Bloecke in der echten nginx-Server-
# Konfiguration ergaenzen (Platzhalter, nicht wortwoertlich uebernehmbar -
# haengt vom tatsaechlichen server{}-Block der Domain ab):
#
#   location ~ (^|/)\.git(/|$)                { deny all; return 404; }
#   location ~ ^/\.                            { deny all; return 404; }
#   location ~ \.(sql|log|bak|backup|old|orig|swp|md|py)$ { deny all; return 404; }
#   location ~ \.local\.php$                   { deny all; return 404; }
#   location ~ ^/(config|database|vendor)/     { deny all; return 404; }
#   autoindex off;
# ──────────────────────────────────────────────────────────────────────
