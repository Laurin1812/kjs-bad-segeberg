APP_NAME="KJS Bad Segeberg"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# KJS Bad Segeberg: eigene, isolierte lokale Entwicklungsdatenbank - niemals
# die bestehende Produktionsdatenbank hier eintragen. Zugangsdaten für die
# echte Zielumgebung gehören ausschließlich in eine lokale, nicht committete
# .env (siehe .gitignore) bzw. später in die Server-Konfiguration.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kjs_laravel_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Netlify Identity -> Laravel Fortify: fest vergebener Cookie-Name (statt
# des sonst aus APP_NAME abgeleiteten Standardwerts) - api/lib/
# identity_auth.php (Hundeboerse/Waffenboerse/Kontakt-Sondermodule, siehe
# dortiger Datei-Kommentar) liest denselben Cookie eigenstaendig aus einem
# reinen PHP-Skript (ohne Laravel-Bootstrap) und muss den Namen daher genau
# kennen, statt ihn aus einer sich potenziell aendernden APP_NAME
# abzuleiten.
SESSION_COOKIE=kjs_admin_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 5B.1 (sichere Laravel-Medienarchitektur, siehe config/kjs_media.php
# für die vollständige Begründung): alle Variablen hier sind optional - ohne
# sie greifen lokale Repo-Root-relative Defaults (images/, downloads/), die
# in dieser Sandbox/lokalen Entwicklung genau die bestehenden Ordner treffen.
# Auf dem echten Server (Carsten) müssen mindestens KJS_IMAGES_PATH und
# KJS_DOWNLOADS_PATH auf die dortigen tatsächlichen Verzeichnisse zeigen -
# siehe Abschlussbericht "Server-Anforderungen" für den vollständigen
# Klärungsbedarf (Apache/nginx, DocumentRoot, Schreibrechte, GD, fileinfo,
# upload_max_filesize, post_max_size).
# KJS_IMAGES_PATH=/var/www/kjs/images
# KJS_IMAGES_URL_PREFIX=/images
# KJS_DOWNLOADS_PATH=/var/www/kjs/downloads
# KJS_DOWNLOADS_URL_PREFIX=/downloads
# KJS_MAX_IMAGE_BYTES=15728640
# KJS_MAX_PDF_BYTES=20971520
# KJS_THUMB_MAX_DIMENSION=480
# KJS_THUMB_QUALITY=72
# KJS_CARD_MAX_DIMENSION=800
# KJS_CARD_QUALITY=78

# Netlify Identity -> Laravel Fortify (Admin-Authentifizierung, siehe
# Abschlussbericht): IDENTITY_JWT_SECRET/_ISSUER/_AUDIENCE sowie
# config/identity.local.php (Repo-Wurzelverzeichnis) werden NICHT MEHR
# benoetigt - weder vom Laravel-Layer (App\Support\AdminIdentity liest jetzt
# die Laravel-Session statt eines JWT) noch vom PHP-Sondermodul-Layer
# (api/lib/identity_auth.php liest jetzt dieselbe Laravel-Session direkt aus
# der Datenbank, siehe dortiger Datei-Kommentar). Die frueher hier
# dokumentierten Variablen koennen aus einer echten Server-.env entfernt
# werden, sobald diese Umstellung dort deployed ist.
#
# STATTDESSEN braucht der PHP-Sondermodul-Layer jetzt genau zwei bereits an
# anderer Stelle vorhandene Werte aus GENAU DIESER .env (liest sie direkt,
# ohne Laravel zu booten): APP_KEY (oben) und SESSION_COOKIE (siehe oben) -
# beide muessen daher auf dem echten Server in dieser Datei
# (laravel/.env) gesetzt sein, nicht nur in einer moeglichen zweiten Kopie.
