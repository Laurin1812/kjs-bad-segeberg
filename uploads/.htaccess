# Oeffentlich erreichbarer Bild-Upload-Ordner (api/lib/boerse_upload.php):
# Bilder aus oeffentlichen Hundeboerse-/Waffenboerse-Einreichungen liegen
# hier als echte Dateien (siehe database/schema.sql-Kommentar "Bilder nicht
# als Base64 in MySQL"). Verteidigung in der Tiefe, falls trotz strenger
# serverseitiger Pruefung (MIME-Erkennung per fileinfo, Zufallsdateiname,
# getimagesize()-Plausibilitaetscheck) jemals eine unerwuenschte Datei
# hierher gelangen sollte: PHP-Ausfuehrung in diesem Ordner ist komplett
# deaktiviert, Verzeichnislisten sind aus.

# Apache >= 2.4
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|php\d|phtml|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI

# WICHTIG (Security-Finalisierung, Punkt "Bildupload"): .htaccess wird NUR
# von Apache ausgewertet. Laeuft der echte PHP-Host (kjs.mysolution-
# webservice.de) unter nginx (oder Apache im nginx-Reverse-Proxy-Betrieb
# ohne mod_php/AllowOverride fuer diesen Ordner), hat diese Datei GAR KEINE
# Wirkung - PHP-Dateien in diesem Ordner waeren dann trotz serverseitiger
# Upload-Pruefung (siehe api/lib/boerse_upload.php: MIME-Erkennung per
# fileinfo, getimagesize()-Check, feste Zufallsdateinamen, keine .php/
# .phtml/.phar/.svg in der erlaubten Endungsliste) im Ernstfall trotzdem
# ausfuehrbar und das Verzeichnis eventuell listbar. Carsten muesste in
# diesem Fall serverseitig sicherstellen (per Rueckfrage beim Hoster/
# Admin, welcher Webserver tatsaechlich laeuft), dass ein nginx-
# "location"-Block etwa der folgenden Form fuer /uploads/ aktiv ist (auf den
# echten Serverblock der Site angepasst, NICHT wortwoertlich uebernehmbar):
#
#   location ^~ /uploads/ {
#       location ~ \.(php|php\d|phtml|phar)$ {
#           deny all;
#           return 403;
#       }
#       autoindex off;
#   }
#
# Ohne diese (oder eine gleichwertige) nginx-Konfiguration ist die
# "Verteidigung in der Tiefe" fuer diesen Ordner unter nginx NICHT
# vorhanden - das laesst sich von hier aus mangels Zugriff auf die echte
# Serverkonfiguration nicht selbst herstellen, siehe Abschlussbericht.
