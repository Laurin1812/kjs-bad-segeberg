# ist aber ein reines Server-/Setup-Artefakt und nicht fuer den oeffentlichen
# Abruf gedacht - aus Konsistenz genauso wie /api/ und /vendor/ oben
# geblockt.
/database/* /  404!

# Security-/Datenschutz-Hardening (11.09.2026): config/*.example.php-Dateien
# enthalten keine echten Zugangsdaten (nur Platzhalter "CHANGE-ME", echte
# Werte liegen ausschliesslich in den nie committeten config/*.local.php -
# siehe .gitignore), wurden aber bislang von Netlify direkt als Klartext
# ausgeliefert (live geprueft: HTTP 200 auf z.B. /config/db.example.php).
# config/.htaccess wirkt nur auf einem echten Apache-Server, nicht auf
# Netlify - deshalb hier zusaetzlich, aus Konsistenz mit /api/, /vendor/,
# /database/, geblockt.
/config/*   /  404!

